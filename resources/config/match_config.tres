[gd_resource type="Resource" script_class="MatchConfig" format=3]

[ext_resource type="Script" path="res://scripts/resources/match_config.gd" id="1_match"]
[ext_resource type="Script" path="res://scripts/resources/character_stats.gd" id="2_stats"]
[ext_resource type="Resource" path="res://resources/characters/princess.tres" id="3_princess"]
[ext_resource type="Resource" path="res://resources/characters/mage.tres" id="4_mage"]
[ext_resource type="Script" path="res://scripts/resources/qte_config.gd" id="5_qte"]
[ext_resource type="Script" path="res://scripts/resources/wave_data.gd" id="6_wave"]
[ext_resource type="Resource" path="res://resources/enemies/soldier.tres" id="7_soldier"]

[sub_resource type="Resource" id="Resource_qte"]
script = ExtResource("5_qte")

[sub_resource type="Resource" id="Resource_wave1"]
script = ExtResource("6_wave")
delay_before = 0.8
enemy = ExtResource("7_soldier")
count = 4

[sub_resource type="Resource" id="Resource_wave2"]
script = ExtResource("6_wave")
delay_before = 2.0
enemy = ExtResource("7_soldier")
count = 6

[resource]
script = ExtResource("1_match")
characters = Array[ExtResource("2_stats")]([ExtResource("3_princess"), ExtResource("4_mage")])
qte = SubResource("Resource_qte")
confront_waves = Array[ExtResource("6_wave")]([SubResource("Resource_wave1"), SubResource("Resource_wave2")])
