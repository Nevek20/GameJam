scene = ExtResource("13_particles")
initial_size = 40

[node name="DamageNumbers" type="Node2D" parent="."]
z_index = 20
script = ExtResource("9_pool")
scene = ExtResource("14_number")
initial_size = 30

[node name="Camera" type="Camera2D" parent="."]
script = ExtResource("17_camera")

[node name="InteractionDirector" type="Node" parent="."]
script = ExtResource("18_interact")

[node name="ArmyEncounter" type="Node" parent="."]
script = ExtResource("19_encounter")

[node name="WaveTimer" type="Timer" parent="ArmyEncounter"]
one_shot = true

[node name="BossDirector" type="Node" parent="."]
script = ExtResource("20_boss_dir")
boss_scene = ExtResource("21_boss")

[node name="UI" type="CanvasLayer" parent="."]
layer = 10

[node name="HUD" parent="UI" instance=ExtResource("22_hud")]
unique_name_in_owner = true

[node name="QTE" parent="UI" instance=ExtResource("24_qte")]
unique_name_in_owner = true

[node name="DialogBox" parent="UI" instance=ExtResource("23_dialog")]
unique_name_in_owner = true

[node name="Tutorial" parent="UI" instance=ExtResource("25_tutorial")]
unique_name_in_owner = true

[node name="IntroLayer" type="CanvasLayer" parent="."]
layer = 20

[node name="Intro" parent="IntroLayer" instance=ExtResource("26_intro")]
unique_name_in_owner = true

[node name="TombLayer" type="CanvasLayer" parent="."]
layer = 30

[node name="Tombstone" parent="TombLayer" instance=ExtResource("27_tomb")]
