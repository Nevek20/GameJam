[node name="Game" type="Node2D"]
script = ExtResource("1_game")
match_config = ExtResource("2_match")
ui_config = ExtResource("3_ui")
player_scene = ExtResource("4_player")

[node name="Juice" type="Node" parent="." node_paths=PackedStringArray("camera")]
script = ExtResource("5_juice")
config = ExtResource("6_juice_cfg")
camera = NodePath("../Camera")

[node name="Pools" type="Node" parent="." node_paths=PackedStringArray("hitboxes", "projectiles", "particles", "damage_numbers", "afterimages", "lightning", "enemies")]
script = ExtResource("7_pools")
hitboxes = NodePath("../Effects/Hitboxes")
projectiles = NodePath("../Effects/Projectiles")
particles = NodePath("../Effects/Particles")
damage_numbers = NodePath("../DamageNumbers")
afterimages = NodePath("../Afterimages")
lightning = NodePath("../Effects/Lightning")
enemies = NodePath("../Level/World/Actors/Enemies")

[node name="Level" parent="." instance=ExtResource("8_level")]

[node name="Enemies" type="Node2D" parent="Level/World/Actors"]
y_sort_enabled = true
script = ExtResource("9_pool")
scene = ExtResource("10_enemy")
initial_size = 18

[node name="Afterimages" type="Node2D" parent="."]
z_index = -1
script = ExtResource("9_pool")
scene = ExtResource("15_after")
initial_size = 24

[node name="Effects" type="Node2D" parent="."]
z_index = 5

[node name="Hitboxes" type="Node2D" parent="Effects"]
