; Engine configuration file.
; Camadas de colisão documentadas em scripts/core/layers.gd (manter em sincronia).

config_version=5

[application]

config/name="Vila Psicodélica"
config/description="Jogo de game jam: 2D top-down de ação em uma vila de fantasia psicodélica."
run/main_scene="res://ui/menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

Settings="*res://scripts/autoload/settings.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
ReputationState="*res://scripts/autoload/reputation_state.gd"
GameState="*res://scripts/autoload/game_state.gd"
GameManager="*res://scripts/autoload/game_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

theme/custom="res://ui/theme/main_theme.tres"

