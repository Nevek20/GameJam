[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="player_hitbox"
2d_physics/layer_5="enemy_hitbox"
2d_physics/layer_6="npc"
2d_physics/layer_7="projectile"
2d_physics/layer_8="player_hurtbox"
2d_physics/layer_9="enemy_hurtbox"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.035, 0.1, 1)
2d/snap/snap_2d_transforms_to_pixel=false
